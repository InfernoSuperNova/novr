<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>

    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <SkipNuclearOptionReferences>true</SkipNuclearOptionReferences>
    <RootNamespace>NOVR.Installer</RootNamespace>

    <ApplicationIcon />
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Self-contained single-file executable -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <PublishReadyToRun>false</PublishReadyToRun>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>

    <InstallerDistDir>$(MSBuildThisFileDirectory)../dist</InstallerDistDir>
    <InstallerPublishIntermediateDir>$(BaseIntermediateOutputPath)publish</InstallerPublishIntermediateDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.6" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.6" />
  </ItemGroup>

  <Target Name="PublishInstallersToDist"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' And '$(IsPublishingInstaller)' != 'true'">

    <MakeDir Directories="$(InstallerDistDir)" />

    <Exec Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot; -c $(Configuration) -r linux-x64 --no-restore -p:IsPublishingInstaller=true -p:SelfContained=true -p:PublishSingleFile=true -p:PublishDir=&quot;$(InstallerPublishIntermediateDir)/linux-x64/&quot;" />

    <Exec Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot; -c $(Configuration) -r win-x64 --no-restore -p:IsPublishingInstaller=true -p:SelfContained=true -p:PublishSingleFile=true -p:PublishDir=&quot;$(InstallerPublishIntermediateDir)/win-x64/&quot;" />

    <Copy
            SourceFiles="$(InstallerPublishIntermediateDir)/linux-x64/NOVR.Installer"
            DestinationFiles="$(InstallerDistDir)/NOVR.Installer-Linux"
            SkipUnchangedFiles="true" />

    <Copy
            SourceFiles="$(InstallerPublishIntermediateDir)/win-x64/NOVR.Installer.exe"
            DestinationFiles="$(InstallerDistDir)/NOVR.Installer-Win.exe"
            SkipUnchangedFiles="true" />

  </Target>

</Project>